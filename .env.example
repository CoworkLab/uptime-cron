# ---- Required ----
TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
DEV_API_KEY=uc_dev_generate_with_openssl_rand_hex_24

# ---- Optional (defaults shown) ----
DEFAULT_TIMEZONE=Asia/Kolkata
USER_JOB_LIMIT=25
HISTORY_LIMIT=50
MIN_INTERVAL_SECONDS=120
TICK_SECONDS=10
MAX_CONCURRENCY=20
RATE_LIMIT_PER_MIN=120
PORT=8080

# ---- v1.2.0 uptime monitoring (optional) ----
# Telegram alert delivery (create a bot with @BotFather, then set this)
TELEGRAM_BOT_TOKEN=
# Email alerts via Resend (optional; alerts are skipped when unset)
RESEND_API_KEY=
RESEND_FROM=
# Max alert contacts per user
USER_CONTACT_LIMIT=10
